# Claude Agent SDK agent (backend/main.ts). Copy to backend/.env.
# main.ts calls dotenv.config(), so this file is loaded automatically.

# Required. The model key, read by the Claude Agent SDK.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Model id. Defaults to claude-sonnet-4-6.
# CLAUDE_MODEL=claude-sonnet-4-6

# Optional. Agent port. Defaults to 8000.
# If you change it, set CLAUDE_AGENT_URL in frontend/.env to match.
# AGENT_PORT=8000
