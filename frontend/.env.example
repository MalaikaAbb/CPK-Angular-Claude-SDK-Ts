# Copilot Runtime (frontend/server.ts).
# server.ts does not load a .env file: set these in the environment of the
# terminal that runs `npm run runtime` / `npm run dev`.

# Required. Intelligence project API key. `npx copilotkit@latest project select`
# writes it to .env in the directory where you run it. Keep it server-side.
CPK_INTELLIGENCE_API_KEY=cpk-...

# Optional. Where the runtime finds the agent. Defaults to http://localhost:8000/.
# CLAUDE_AGENT_URL=http://localhost:8000/

# Optional. Runtime port. Defaults to 8200.
# If you change it, change runtimeUrl in src/app/app.config.ts too.
# PORT=8200

# Optional. Opt out of anonymous runtime telemetry.
# COPILOTKIT_TELEMETRY_DISABLED=true
CPK_TELEMETRY_ID=